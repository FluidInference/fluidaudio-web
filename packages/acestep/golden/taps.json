{
  "schemaVersion": 1,
  "layout": "contiguous-little-endian",
  "symbols": {
    "B": "batch size; v1 fixtures use 1",
    "T": "max(128, floor(durationSeconds * 48000 / 1920)) latent frames",
    "P": "ceil(T / 2) patched DiT tokens before implementation padding",
    "LT": "caption tokenizer sequence length",
    "LL": "lyric tokenizer sequence length",
    "E": "packed lyric+timbre+caption condition length",
    "C5": "planner semantic-code count, normally durationSeconds * 5",
    "R": "total categorical planner draws across CoT and semantic-code phases",
    "S": "audio samples per channel, normally durationSeconds * 48000"
  },
  "captureRules": {
    "fullMaximumBytes": 8388608,
    "slice": "For larger tensors capture the first and last 4 tokens/frames, token indices floor(n/4), floor(n/2), floor(3n/4), and channels 0:64; also capture whole-tensor stats.",
    "stats": ["count", "finiteCount", "nanCount", "infCount", "min", "max", "meanF64", "rmsF64", "l1F64"],
    "hash": "SHA-256 over the complete contiguous tensor bytes whenever a full tensor is emitted"
  },
  "taps": [
    {"id":"token.caption.ids","stage":"tokenize","required":"all","dtype":"int64","shape":["B","LT"],"capture":"full"},
    {"id":"token.caption.mask","stage":"tokenize","required":"all","dtype":"bool","shape":["B","LT"],"capture":"full"},
    {"id":"token.lyric.ids","stage":"tokenize","required":"all","dtype":"int64","shape":["B","LL"],"capture":"full"},
    {"id":"token.lyric.mask","stage":"tokenize","required":"all","dtype":"bool","shape":["B","LL"],"capture":"full"},
    {"id":"text.embedding.input","stage":"text","required":"all","dtype":"bfloat16","shape":["B","LT",1024],"capture":"slice+stats"},
    {"id":"text.layer.13.output","stage":"text","required":"all","dtype":"bfloat16","shape":["B","LT",1024],"capture":"slice+stats"},
    {"id":"text.final.output","stage":"text","required":"all","dtype":"bfloat16","shape":["B","LT",1024],"capture":"slice+stats"},
    {"id":"lyric.embedding.input","stage":"text","required":"all","dtype":"bfloat16","shape":["B","LL",1024],"capture":"slice+stats"},
    {"id":"planner.prompt.ids","stage":"planner","required":"planner","dtype":"int64","shape":[1,"variable"],"capture":"full"},
    {"id":"planner.code.ids","stage":"planner","required":"planner","dtype":"int64","shape":["B","C5",1],"capture":"full"},
    {"id":"planner.logits.probes","stage":"planner","required":"planner","dtype":"float32","shape":["probe-steps",64000],"capture":"full"},
    {"id":"planner.sample.words","stage":"planner","required":"planner","dtype":"uint32","shape":["R"],"capture":"full"},
    {"id":"semantic.fsq.output","stage":"semantic","required":"planner","dtype":"bfloat16","shape":["B","C5",2048],"capture":"slice+stats"},
    {"id":"semantic.detokenizer.layer.0","stage":"semantic","required":"planner","dtype":"bfloat16","shape":["B","T",2048],"capture":"slice+stats"},
    {"id":"semantic.hints.25hz","stage":"semantic","required":"planner","dtype":"bfloat16","shape":["B","T",64],"capture":"slice+stats"},
    {"id":"condition.lyric.layer.0","stage":"condition","required":"all","dtype":"bfloat16","shape":["B","LL",2048],"capture":"slice+stats"},
    {"id":"condition.lyric.final","stage":"condition","required":"all","dtype":"bfloat16","shape":["B","LL",2048],"capture":"slice+stats"},
    {"id":"condition.timbre.final","stage":"condition","required":"all","dtype":"bfloat16","shape":["B","variable",2048],"capture":"slice+stats"},
    {"id":"condition.encoder.output","stage":"condition","required":"all","dtype":"bfloat16","shape":["B","E",2048],"capture":"slice+stats"},
    {"id":"condition.encoder.mask","stage":"condition","required":"all","dtype":"bool","shape":["B","E"],"capture":"full"},
    {"id":"condition.context","stage":"condition","required":"all","dtype":"bfloat16","shape":["B","T",128],"capture":"slice+stats"},
    {"id":"diffusion.initial-noise","stage":"dit","required":"all","dtype":"float32","shape":["B","T",64],"capture":"full"},
    {"id":"dit.step.{0,7}.input","stage":"dit","required":"all","dtype":"bfloat16","shape":["B","T",64],"capture":"slice+stats"},
    {"id":"dit.step.{0,7}.layer.{0,1,22,23}.output","stage":"dit","required":"all","dtype":"bfloat16","shape":["B","P",2048],"capture":"slice+stats"},
    {"id":"dit.step.{0,7}.velocity","stage":"dit","required":"all","dtype":"bfloat16","shape":["B","T",64],"capture":"slice+stats"},
    {"id":"dcw.step.{0,7}.denoised","stage":"dcw","required":"all","dtype":"float32","shape":["B","T",64],"capture":"slice+stats"},
    {"id":"dcw.step.{0,7}.output","stage":"dcw","required":"all","dtype":"bfloat16","shape":["B","T",64],"capture":"slice+stats"},
    {"id":"diffusion.final-latent","stage":"dit","required":"all","dtype":"bfloat16","shape":["B","T",64],"capture":"full"},
    {"id":"vae.nonchunked.output","stage":"vae","required":"short-fixtures","dtype":"float32","shape":["B",2,"S"],"capture":"slice+stats"},
    {"id":"vae.chunked.raw-output","stage":"vae","required":"all","dtype":"float32","shape":["B",2,"S"],"capture":"slice+stats"},
    {"id":"audio.final-output","stage":"audio","required":"all","dtype":"float32","shape":["B",2,"S"],"capture":"slice+stats"}
  ]
}
