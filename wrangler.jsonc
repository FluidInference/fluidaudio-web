{
  // Cloudflare Worker serving the built static site (Workers Static Assets).
  // No Worker script needed — just publish ./dist. `npx wrangler deploy` pushes
  // to https://fluidaudio-web.<account>.workers.dev. Build first: `npm run build`.
  // NOTE: no _headers / COOP / COEP — cross-origin isolation breaks the
  // cross-origin Hugging Face / jsdelivr model downloads (see vite.config.ts).
  "name": "fluidaudio-web",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
