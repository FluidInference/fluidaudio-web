{
  "name": "@fluidinference/fluidaudio-web",
  "version": "0.0.1",
  "private": true,
  "description": "In-browser inference for FluidAudio's core models via WebGPU + WASM",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/FluidInference/fluidaudio-web#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/FluidInference/fluidaudio-web.git"
  },
  "bugs": {
    "url": "https://github.com/FluidInference/fluidaudio-web/issues"
  },
  "keywords": [
    "asr",
    "tts",
    "diarization",
    "vad",
    "webgpu",
    "wasm",
    "onnxruntime-web",
    "speech",
    "parakeet",
    "kokoro",
    "whisper",
    "sortformer",
    "in-browser"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "bench": "vite --open /bench.html?full=1",
    "build": "tsc --noEmit && vite build && node scripts/postbuild-strip-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gpu:verify": "node scripts/gpu-verify.mjs",
    "gpu:bench": "node scripts/gpu-bench.mjs",
    "gpu:albert": "node scripts/gpu-albert.mjs",
    "gpu:lstm": "node scripts/gpu-lstm.mjs",
    "gpu:convt": "node scripts/gpu-convt.mjs",
    "gpu:kokoro-cost": "node scripts/gpu-kokoro-cost.mjs",
    "gpu:kokoro-forward": "node scripts/gpu-kokoro-forward.mjs",
    "gpu:kokoro": "node scripts/gpu-kokoro.mjs",
    "wasm:build": "cd rust/wasm-kernels && RUSTFLAGS='-C target-feature=+simd128' cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/wasm_kernels.wasm ../../src/gpu/wasm-kernels.wasm",
    "wasm:verify": "node scripts/wasm-verify.mjs",
    "backend:parity": "node scripts/backend-parity.mjs"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.2"
  },
  "devDependencies": {
    "@kmamal/gpu": "^0.2.1",
    "onnxruntime-node": "^1.27.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
